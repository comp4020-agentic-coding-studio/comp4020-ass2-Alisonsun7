---
interface WeightedMarking {
  mode: "weighted";
  criteria: { name: string; weight: number; description?: string }[];
}

interface HolisticMarking {
  mode: "holistic";
  description: string;
}

interface Props {
  marking: WeightedMarking | HolisticMarking;
}

const { marking } = Astro.props;
const showDescriptions = marking.mode === "weighted" && marking.criteria.some((criterion) => criterion.description);
---

<section aria-labelledby="how-marked">
  <h2 id="how-marked">How it is marked</h2>
  {marking.mode === "holistic" ? (
    <p>{marking.description}</p>
  ) : (
    <table>
      <thead>
        <tr>
          <th scope="col">Criterion</th>
          {showDescriptions && <th scope="col">What markers look for</th>}
          <th scope="col">Weight</th>
        </tr>
      </thead>
      <tbody>
        {marking.criteria.map((criterion) => (
          <tr>
            <td>{criterion.name}</td>
            {showDescriptions && <td>{criterion.description}</td>}
            <td>{criterion.weight}%</td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</section>
