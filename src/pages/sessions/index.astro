---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description={`The twelve-week teaching schedule: what happens in each ${sessionLabels.singular.toLowerCase()}, what to prepare, and what leaves the room.`}
  {...siteConfig}
>
  <p>
    Twelve weeks in a fixed order, each building on at least one earlier one
    (see each week's <code>buildsOn</code>). The arc runs SEE (Weeks 1–3, what
    "price" actually means) into CALCULATE (Weeks 4–9, working out discounts,
    time, situations and alternatives) into DECIDE (Weeks 10–12, choosing when
    money is not the only thing that matters). Start at{" "}
    <a href={withBase("/sessions/week-01/")}>Week 1</a> if you're new here — the $249
    headphones example introduced there runs through every week after it.
  </p>
  <SessionsGrid />
</ContentLayout>
